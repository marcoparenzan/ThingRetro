<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The studio in the browser: a Blazor Server app (projects, files, editor, assembler and builds run on the
       server, over a local folder of projects). The C65 is the WebAssembly web computer (Thing65.WebComputer, the
       AOT build published to artifacts/web), shown in an iframe at /computer/ -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- RalfAI (the assistant) comes from the local feed of nuget.config. It brings SixLabors.ImageSharp 3.1.11, which
       has known vulnerabilities fixed only in 4.x: the upgrade belongs to RalfAI (its image tools are built on 3.x) -->
  <ItemGroup>
    <PackageReference Include="RalfAI.Core" Version="1.0.5" />
    <PackageReference Include="Markdig" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\ThingMOS\src\ThingMOS\ThingMOS.csproj" />
    <ProjectReference Include="..\..\..\ThingRetroEmu\src\ThingRetroEmu\ThingRetroEmu.csproj" />
    <ProjectReference Include="..\..\..\ThingCommodore\src\ThingCommodore.Tools\ThingCommodore.Tools.csproj" />
  </ItemGroup>

  <!-- Files of the rest of the repository: the 6502 language of the editor, logo and icons. Embedded and served by
       Program.cs at the path in their name (linked static web assets come out empty in development) -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\ThingMOS\src\ThingMOS\Asm\Editor\asm6502.js" LogicalName="wwwroot/js/asm6502.js" />
    <EmbeddedResource Include="..\..\images\logos\thing65-logo-600x200.png;..\..\images\icons\thing65-chip-16.png;..\..\images\icons\thing65-chip-32.png;..\..\images\icons\thing65-chip-64.png;..\..\images\icons\thing65-chip-256.png"
                      LogicalName="wwwroot/img/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
