<Project Sdk="Microsoft.NET.Sdk">

  <!-- The thing65 command line: assembles, tokenizes BASIC, builds projects, and starts the desktop app (a C64 in a
       window, Thing65.Computer). Packaged as a .NET global tool (see tools/Install-Tool.ps1); a tool cannot use
       Windows Forms itself, so the desktop app travels inside the package, in the "desktop" folder -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Thing65.Cli</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>thing65</ToolCommandName>
    <PackageId>Thing65</PackageId>
    <Version>0.1.0</Version>
    <Authors>Marco Parenzan</Authors>
    <Description>A Commodore 64 (PAL) emulator written to be read, with a C64 window, an ACME-compatible assembler and a BASIC tokenizer.</Description>
    <PackageOutputPath>..\..\artifacts</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Thing65.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.56.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\ThingMOS\src\ThingMOS\ThingMOS.csproj" />
    <ProjectReference Include="..\..\..\ThingRetroEmu\src\ThingRetroEmu\ThingRetroEmu.csproj" />
    <ProjectReference Include="..\..\..\ThingCommodore\src\ThingCommodore.Tools\ThingCommodore.Tools.csproj" />
  </ItemGroup>

  <!-- When the tool is packed: the desktop app is published and added to the package under "desktop" -->
  <Target Name="PublishDesktop" BeforeTargets="ComputeResolvedFilesToPublishList" Condition="'$(PackAsTool)' == 'true'">
    <PropertyGroup>
      <DesktopPublishDir>$(MSBuildProjectDirectory)\obj\desktop\$(Configuration)\</DesktopPublishDir>
    </PropertyGroup>
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\Thing65.Computer\Thing65.Computer.csproj&quot; -c $(Configuration) -o &quot;$(DesktopPublishDir.TrimEnd('\'))&quot; --nologo -v q" />
    <ItemGroup>
      <_DesktopFile Include="$(DesktopPublishDir)**\*" />
      <ResolvedFileToPublish Include="@(_DesktopFile)" RelativePath="desktop\%(_DesktopFile.RecursiveDir)%(_DesktopFile.Filename)%(_DesktopFile.Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
