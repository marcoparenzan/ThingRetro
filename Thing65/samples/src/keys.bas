1 REM KEYS - FUNCTION KEYS AND CURSOR KEYS
2 REM GET READS A KEY FROM THE BUFFER; F1-F8 ARE CODES 133-140
3 REM CURSOR: DOWN 17, UP 145, RIGHT 29, LEFT 157
10 PRINT CHR$(147)"PRESS F1-F8 OR THE CURSOR KEYS"
20 PRINT "(Q TO QUIT)":PRINT
30 GET K$:IF K$="" THEN 30
40 IF K$="Q" THEN END
50 K=ASC(K$)
60 IF K>=133 AND K<=140 THEN PRINT "F";MID$("13572468",K-132,1):GOTO 30
70 IF K=17 THEN PRINT "CURSOR DOWN":GOTO 30
80 IF K=145 THEN PRINT "CURSOR UP":GOTO 30
90 IF K=29 THEN PRINT "CURSOR RIGHT":GOTO 30
100 IF K=157 THEN PRINT "CURSOR LEFT":GOTO 30
110 PRINT "CODE";K:GOTO 30
