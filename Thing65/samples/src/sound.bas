1 REM SOUND - A SCALE PLAYED BY VOICE 1 OF THE SID
2 REM 54272 = $D400: VOICE 1 IN $D400-$D406, VOLUME IN $D418
3 REM FREQUENCY REGISTER = HZ * 17.03 (PAL), AS HIGH AND LOW BYTE
4 REM ENVELOPE: ATTACK 0, DECAY 9, SUSTAIN 0: THE NOTE FADES OUT
10 S=54272:FOR I=0 TO 24:POKE S+I,0:NEXT
20 POKE S+24,15:REM FULL VOLUME
30 POKE S+5,9:POKE S+6,0
40 PRINT CHR$(147)"A SCALE FROM THE SID":PRINT
50 FOR N=1 TO 8:READ H,L,N$
60 PRINT N$;" ";
70 POKE S+1,H:POKE S,L
80 POKE S+4,17:REM TRIANGLE + GATE: THE ENVELOPE STARTS
90 FOR T=1 TO 150:NEXT
100 POKE S+4,16:REM GATE OFF: RELEASE
110 FOR T=1 TO 50:NEXT
120 NEXT
130 PRINT:PRINT:PRINT "THE END"
200 DATA 17,103,C,19,137,D,21,237,E,23,59,F
210 DATA 26,19,G,29,69,A,32,218,B,34,206,C
