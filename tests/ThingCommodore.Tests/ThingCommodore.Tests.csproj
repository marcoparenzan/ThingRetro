<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="ThingCommodore.Drives" />
    <Using Include="ThingMOS" />
    <Using Include="ThingRetroEmu.Chips" />
    <Using Include="ThingRetroEmu.Buses" />
    <Using Include="ThingRetroEmu.Media" />
  </ItemGroup>

  <!-- The ROMs, copied next to the tests (installed with tools/Install-Roms.ps1) -->
  <ItemGroup>
    <Content Include="../../roms/*.rom" Link="roms/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The computers the peripherals are plugged into in the tests -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\ThingCommodore\ThingCommodore.csproj" />
    <ProjectReference Include="..\..\..\Thing65\src\Thing65.C65\Thing65.C65.csproj" />
    <ProjectReference Include="..\..\..\Thing64\src\Thing64.C64\Thing64.C64.csproj" />
  </ItemGroup>

</Project>
