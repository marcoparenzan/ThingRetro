1 REM JOYSTICK - THE SPRITE MOVES WITH THE JOYSTICK IN PORT 2
2 REM PEEK(56320) = $DC00: BIT AT 0 = CONTACT CLOSED
3 REM BIT 0 UP, 1 DOWN, 2 LEFT, 3 RIGHT, 4 FIRE
10 V=53248:PRINT CHR$(147)"JOYSTICK IN PORT 2"
20 FOR I=0 TO 62:READ D:POKE 832+I,D:NEXT
30 POKE 2040,13:POKE V+39,7:POKE V+21,1
40 X=160:Y=140
50 J=PEEK(56320)
60 IF (J AND 1)=0 AND Y>50 THEN Y=Y-2
70 IF (J AND 2)=0 AND Y<229 THEN Y=Y+2
80 IF (J AND 4)=0 AND X>24 THEN X=X-2
90 IF (J AND 8)=0 AND X<320 THEN X=X+2
100 POKE V+39,7-6*((J AND 16)=0)
110 POKE V,X AND 255:POKE V+16,-(X>255):POKE V+1,Y
120 GOTO 50
200 DATA 0,255,0
210 DATA 3,255,192
220 DATA 7,255,224
