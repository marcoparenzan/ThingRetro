1 REM SOUND - UNA SCALA SUONATA DALLA VOCE 1 DEL SID
2 REM 54272 = $D400: VOCE 1 IN $D400-$D406, VOLUME IN $D418
3 REM REGISTRO DI FREQUENZA = HZ * 17.03 (PAL), IN BYTE ALTO E BASSO
4 REM INVILUPPO: ATTACCO 0, DECADIMENTO 9, SOSTEGNO 0: LA NOTA SI SPEGNE
10 S=54272:FOR I=0 TO 24:POKE S+I,0:NEXT
20 POKE S+24,15:REM VOLUME MASSIMO
30 POKE S+5,9:POKE S+6,0
40 PRINT CHR$(147)"UNA SCALA DAL SID":PRINT
50 FOR N=1 TO 8:READ H,L,N$
60 PRINT N$;" ";
70 POKE S+1,H:POKE S,L
80 POKE S+4,17:REM TRIANGOLO + GATE: PARTE L'INVILUPPO
90 FOR T=1 TO 150:NEXT
100 POKE S+4,16:REM GATE A ZERO: RILASCIO
110 FOR T=1 TO 50:NEXT
120 NEXT
130 PRINT:PRINT:PRINT "FINE"
200 DATA 17,103,DO,19,137,RE,21,237,MI,23,59,FA
210 DATA 26,19,SOL,29,69,LA,32,218,SI,34,206,DO
