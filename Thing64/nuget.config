<?xml version="1.0" encoding="utf-8"?>
<!-- nuget.org, plus the local feed with the RalfAI packages used by the web studio's assistant -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="D:\Dev\NuGetLocalFeed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="RalfAI.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
