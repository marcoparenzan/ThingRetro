@using Thing64.WebStudio.Components.Memory

@* The memory of the C64 (a snapshot of the running machine) to look through, one viewer for each thing to find in it: the bytes (raw RAM or
   decoded as the CPU sees it), a charset, sprites, a screen of characters, a bitmap. The snapshot stays in the browser (memory-view.js): the
   viewers draw from it and move through it without going back to the server. Taking the snapshot again updates all of them *@
<div class="@(Visible ? "flex" : "hidden") absolute inset-0 z-10 flex-col overflow-hidden bg-night-900 text-xs text-night-200">
    <div class="flex shrink-0 flex-wrap items-center gap-2 border-b border-night-800 bg-night-950 px-3 py-2">
        <span class="text-sm font-semibold text-white">Memory</span>
        <span class="text-night-400">@(HasMemory ? $"snapshot of {takenAt:HH:mm:ss}" : "no snapshot yet")</span>
        <button class="tool border border-night-700" @onclick="OnSnapshot" title="Take the memory of the running C64 again">📷 Snapshot</button>
        <span class="mx-1 h-5 border-l border-night-700"></span>
        @foreach (var (key, label) in Views)
        {
            string choice = key;
            <button class="@(view == choice ? "border-chip-400 bg-night-700 text-white" : "border-night-600") rounded border px-2 py-1" @onclick="() => view = choice">@label</button>
        }
        <button class="tool ml-auto border border-night-700" @onclick="OnClose" title="Back to the C64">✕ Close</button>
    </div>

    @if (!HasMemory)
    {
        <div class="flex flex-1 flex-col items-center justify-center gap-3 text-night-300">
            <p>The memory viewer shows the 64 KB of the running C64. Run a program, then take a snapshot.</p>
            <button class="rounded-md border border-night-600 px-3 py-1.5 text-sm hover:border-chip-400" @onclick="OnSnapshot">📷 Snapshot</button>
        </div>
    }
    else
    {
        @* All the viewers stay: each keeps its offset and its settings while another one is in front *@
        <div class="flex min-h-0 flex-1 flex-col">
            <MemoryDump Active='view == "dump"' />
            <CharsetViewer Active='view == "charset"' />
            <SpriteViewer Active='view == "sprites"' />
            <ScreenViewer Active='view == "screen"' />
            <BitmapViewer Active='view == "bitmap"' />
        </div>
    }
</div>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnSnapshot { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    static readonly (string Key, string Label)[] Views =
    [
        ("dump", "Bytes"), ("charset", "Charset"), ("sprites", "Sprites"), ("screen", "Screen"), ("bitmap", "Bitmap"),
    ];

    string view = "dump";
    DateTime takenAt;

    public bool HasMemory { get; private set; }

    // A new snapshot is in the browser (studio.js has handed it to memory-view.js): the viewers redraw by themselves
    public void SnapshotTaken()
    {
        HasMemory = true;
        takenAt = DateTime.Now;
        StateHasChanged();
    }
}
