<Project Sdk="Microsoft.NET.Sdk">

  <!-- The desktop app: one C64 in a window, with board, monitor, keyboard, speakers and control ports wired
       together, plus loading .prg/.crt files, the ROM folder and the settings -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>..\..\images\thing64.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Thing64.C64\Thing64.C64.csproj" />
    <ProjectReference Include="..\..\..\ThingCommodore\src\ThingCommodore\ThingCommodore.csproj" />
    <ProjectReference Include="..\..\..\ThingCommodore\src\ThingCommodore.WinForms\ThingCommodore.WinForms.csproj" />
    <ProjectReference Include="..\Thing64.WinForms\Thing64.WinForms.csproj" />
    <!-- The 1541 drive of the sibling project ThingCommodore -->
  </ItemGroup>

  <!-- C64 ROMs (KERNAL, BASIC, characters): read from the roms folder next to the executable -->
  <ItemGroup>
    <Content Include="../../roms/*" Link="roms/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The application icon, for the windows -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\images\thing64.ico" LogicalName="thing64.ico" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="ThingRetroEmu.Video" />
    <Using Include="ThingRetroEmu.Audio" />
    <Using Include="ThingRetroEmu.Ports" />
    <Using Include="ThingRetroEmu.WinForms" />
  </ItemGroup>

</Project>
