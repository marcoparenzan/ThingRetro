<Project Sdk="Microsoft.NET.Sdk">

  <!-- A C translator for the 6502: a subset of C (no recursion: parameters and locals have fixed addresses) turned
       into readable assembly for Thing64.Asm, one comment per C statement above its instructions -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
