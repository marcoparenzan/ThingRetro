<Project Sdk="Microsoft.NET.Sdk">

  <!-- The desktop app: one C64 in a window, with board, monitor, keyboard, speakers and control ports wired
       together, plus loading .prg/.crt files, the ROM folder and the settings -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>..\..\images\thing65.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Thing65.C65\Thing65.C65.csproj" />
    <ProjectReference Include="..\Thing65.Crt\Thing65.Crt.csproj" />
    <ProjectReference Include="..\Thing65.Prg\Thing65.Prg.csproj" />
    <ProjectReference Include="..\Thing65.WinForms\Thing65.WinForms.csproj" />
  </ItemGroup>

  <!-- C64 ROMs (KERNAL, BASIC, characters): read from the roms folder next to the executable -->
  <ItemGroup>
    <Content Include="roms\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The application icon, for the windows -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\images\thing65.ico" LogicalName="thing65.ico" />
  </ItemGroup>

</Project>
