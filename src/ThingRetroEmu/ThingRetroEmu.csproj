<Project Sdk="Microsoft.NET.Sdk">

  <!-- The retro hardware as components: chips with their pinouts, sockets, buses and cables, disk media, control ports and the
       assembler. They do not know which computer or drive they are mounted in -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <!-- Code run at every cycle (a million times per second): optimized in Debug too, otherwise it cannot keep up -->
    <Optimize>true</Optimize>
    <Version>0.1.0</Version>
    <PackageId>ThingRetroEmu</PackageId>
    <Description>Chips, sockets, buses, cables, media and assembler of the Thing64, Thing65 and Thing1500 emulators</Description>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="ThingRetroEmu.Chips" />
    <Using Include="ThingRetroEmu.Sockets" />
    <Using Include="ThingRetroEmu.Buses" />
    <Using Include="ThingRetroEmu.Media" />
    <Using Include="ThingRetroEmu.Ports" />
    <InternalsVisibleTo Include="ThingRetroEmu.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Asm\Editor\asm6502.js" Pack="true" PackagePath="content\Asm\" />
  </ItemGroup>

</Project>
