<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="Fake64.C64" />
    <Using Include="Fake64.Mos" />
  </ItemGroup>

  <!-- Le stesse ROM dell'app, copiate in roms accanto ai test -->
  <ItemGroup>
    <Content Include="..\Fake64\roms\*" Link="roms\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fake64.Asm\Fake64.Asm.csproj" />
    <ProjectReference Include="..\Fake64.C64\Fake64.C64.csproj" />
    <ProjectReference Include="..\Fake64.Crt\Fake64.Crt.csproj" />
    <ProjectReference Include="..\Fake64.Prg\Fake64.Prg.csproj" />
    <ProjectReference Include="..\Fake64.Samples\Fake64.Samples.csproj" />
    <ProjectReference Include="..\Fake64.WinForms\Fake64.WinForms.csproj" />
  </ItemGroup>

</Project>
