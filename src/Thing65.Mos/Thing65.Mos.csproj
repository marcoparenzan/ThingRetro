<Project Sdk="Microsoft.NET.Sdk">

  <!-- The MOS chips as standalone components: they do not know which computer they are mounted in.
       Each chip implements its own pinout (I6510Pinout, I6526Pinout, ...), which is the contract of the socket -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <!-- Code run at every cycle (a million times per second): optimized in Debug too, otherwise it cannot keep up -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Thing65.Tests" />
  </ItemGroup>

</Project>
