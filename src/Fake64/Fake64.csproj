<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fake64.Core\Fake64.Core.csproj" />
    <ProjectReference Include="..\Fake64.Crt\Fake64.Crt.csproj" />
    <ProjectReference Include="..\Fake64.Prg\Fake64.Prg.csproj" />
    <ProjectReference Include="..\Fake64.WinForms\Fake64.WinForms.csproj" />
  </ItemGroup>

  <!-- ROM del C64 (KERNAL, BASIC, caratteri): l'app le legge dalla cartella roms accanto all'eseguibile -->
  <ItemGroup>
    <Content Include="roms\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Fake64Form.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

</Project>