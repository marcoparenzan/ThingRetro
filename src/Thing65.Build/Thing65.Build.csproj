<Project Sdk="Microsoft.NET.Sdk">

  <!-- From sources to C64 files: .asm and .bas to .prg, images to graphics data, build manifests (thing65.json) with
       programs, cartridges and graphics assets.
       Used by the thing65 command line and by the web studio -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Thing65.Asm\Thing65.Asm.csproj" />
    <ProjectReference Include="..\Thing65.Basic\Thing65.Basic.csproj" />
    <ProjectReference Include="..\Thing65.Crt\Thing65.Crt.csproj" />
    <ProjectReference Include="..\Thing65.Graphics\Thing65.Graphics.csproj" />
  </ItemGroup>

</Project>
