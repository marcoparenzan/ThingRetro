<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<!-- Code run at every cycle (a million times per second): optimized in Debug too, otherwise it cannot keep up -->
		<Optimize>true</Optimize>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Thing64.Tests" />
	</ItemGroup>

	<!-- The C64 motherboard: mounts the MOS chips (Thing64.Mos) in its sockets -->
	<ItemGroup>
		<ProjectReference Include="..\Thing64.Mos\Thing64.Mos.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="c64disasm_en.txt" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="c64disasm_en.txt">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

</Project>
