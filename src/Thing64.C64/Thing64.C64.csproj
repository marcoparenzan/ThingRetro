<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<!-- Code run at every cycle (a million times per second): optimized in Debug too, otherwise it cannot keep up -->
		<Optimize>true</Optimize>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Thing64.Tests" />
	</ItemGroup>

	<!-- The C64 motherboard: mounts the chips (ThingRetroEmu) in its sockets -->
	<ItemGroup>
		<ProjectReference Include="..\..\..\ThingRetroEmu\src\ThingRetroEmu\ThingRetroEmu.csproj" />
		<ProjectReference Include="..\..\..\ThingMOS\src\ThingMOS\ThingMOS.csproj" />
		<ProjectReference Include="..\..\..\ThingCommodore\src\ThingCommodore\ThingCommodore.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="c64disasm_en.txt" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="c64disasm_en.txt">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

  <ItemGroup>
    <Using Include="ThingCommodore.Cartridges" />
    <Using Include="ThingCommodore.Software" />
    <Using Include="ThingRetroEmu.Sockets" />
    <Using Include="ThingRetroEmu.Video" />
    <Using Include="ThingRetroEmu.Audio" />
    <Using Include="ThingRetroEmu.Ports" />
  </ItemGroup>

</Project>
