<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- The C64 in the browser: the same board and chips, compiled to WebAssembly. The page drives the board one
       frame at a time (requestAnimationFrame) and paints the frames on a canvas -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Release: compiled ahead of time to WebAssembly (needs the wasm-tools workload); the interpreter is far too
       slow for a cycle-exact C64 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Thing64.C64\Thing64.C64.csproj" />
    <ProjectReference Include="..\Thing64.Crt\Thing64.Crt.csproj" />
    <ProjectReference Include="..\Thing64.Prg\Thing64.Prg.csproj" />
  </ItemGroup>

  <!-- The C64 ROMs are copyrighted and are not published with the site: the user loads them once from disk.
       Only Debug builds embed them, for local development -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <EmbeddedResource Include="..\Thing64.Computer\roms\*" LogicalName="roms/%(Filename)" />
  </ItemGroup>

</Project>
