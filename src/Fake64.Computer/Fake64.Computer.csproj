<Project Sdk="Microsoft.NET.Sdk">

  <!-- One C64 in a window: board, monitor, keyboard, speakers and control ports wired together, plus loading
       .prg/.crt files, the ROM folder and the settings shared with the studio -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fake64.C64\Fake64.C64.csproj" />
    <ProjectReference Include="..\Fake64.Crt\Fake64.Crt.csproj" />
    <ProjectReference Include="..\Fake64.Prg\Fake64.Prg.csproj" />
    <ProjectReference Include="..\Fake64.WinForms\Fake64.WinForms.csproj" />
  </ItemGroup>

  <!-- C64 ROMs (KERNAL, BASIC, characters): read from the roms folder next to the executable -->
  <ItemGroup>
    <Content Include="roms\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
