<Project Sdk="Microsoft.NET.Sdk">

  <!-- Genera i programmi di esempio nella cartella samples (vedi samples/README.md) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- I sorgenti degli esempi (samples/src) come risorse: "samples/nome.estensione" -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\samples\src\*.bas;..\..\samples\src\*.asm" LogicalName="samples/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
