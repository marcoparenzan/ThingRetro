<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generates the sample programs into the samples folder (see samples/README.md) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fake64.Asm\Fake64.Asm.csproj" />
  </ItemGroup>

  <!-- The sample sources (samples/src) as resources: "samples/name.extension" -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\samples\src\*.bas;..\..\samples\src\*.asm" LogicalName="samples/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
