<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="Thing65.C65" />
    <Using Include="Thing65.Mos" />
  </ItemGroup>

  <!-- The same ROMs as the app, copied into roms next to the tests -->
  <ItemGroup>
    <Content Include="..\Thing65.Computer\roms\*" Link="roms\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Thing65.Asm\Thing65.Asm.csproj" />
    <ProjectReference Include="..\Thing65.C65\Thing65.C65.csproj" />
    <ProjectReference Include="..\Thing65.Crt\Thing65.Crt.csproj" />
    <ProjectReference Include="..\Thing65.Prg\Thing65.Prg.csproj" />
    <ProjectReference Include="..\Thing65.Basic\Thing65.Basic.csproj" />
    <ProjectReference Include="..\Thing65.Build\Thing65.Build.csproj" />
    <ProjectReference Include="..\Thing65\Thing65.csproj" />
    <ProjectReference Include="..\Thing65.WinForms\Thing65.WinForms.csproj" />
  </ItemGroup>

</Project>
