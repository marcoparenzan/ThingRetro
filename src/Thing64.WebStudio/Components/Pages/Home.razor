@page "/"
@inject ProjectStore Store
@inject NavigationManager Navigation

@* The projects: the folders of the projects folder, most recently changed first, and a new one *@
<PageTitle>Thing64 Studio</PageTitle>

<div class="h-full overflow-auto">
    <div class="mx-auto max-w-5xl px-6 py-8">
        <section class="mb-8 rounded-xl bg-night-900 p-6 text-night-100 shadow-lg">
            <h1 class="text-2xl font-bold text-white">Projects</h1>
            <p class="mt-1 text-sm text-night-300">
                Each project is a folder in <code class="font-mono text-chip-300">@Store.Root</code>, with everything inside:
                sources, the build manifest <code class="font-mono text-chip-300">thing64.json</code> and the built programs.
            </p>
            <form class="mt-5 flex flex-wrap gap-3" @onsubmit="Create">
                <input @bind="newName" @bind:event="oninput" placeholder="New project name"
                       class="min-w-64 flex-1 rounded-lg border border-night-600 bg-night-800 px-3 py-2 text-white placeholder:text-night-400 focus:border-chip-400 focus:outline-none" />
                <button type="submit" disabled="@string.IsNullOrWhiteSpace(newName)"
                        class="rounded-lg bg-chip-400 px-5 py-2 font-semibold text-night-900 hover:bg-chip-300 disabled:opacity-40">
                    Create project
                </button>
            </form>
            @if (error is not null) { <p class="mt-3 text-sm text-red-300">@error</p> }
        </section>

        @if (projects.Count == 0)
        {
            <p class="text-night-400">No projects yet: create the first one.</p>
        }
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var project in projects)
            {
                <li>
                    <a href="@ProjectUrl(project.Name)"
                       class="group flex items-center gap-3 rounded-xl border border-night-200 bg-white p-4 shadow-sm transition hover:border-chip-400 hover:shadow-md">
                        <img src="img/thing64-chip-64.png" alt="" class="h-10 w-10 transition group-hover:scale-110" />
                        <div class="min-w-0">
                            <div class="truncate font-semibold">@project.Name</div>
                            <div class="text-xs text-night-400">
                                @project.Changed.ToString("yyyy-MM-dd HH:mm")
                                @if (!project.HasManifest) { <span> · no thing64.json</span> }
                            </div>
                        </div>
                    </a>
                </li>
            }
        </ul>
    </div>
</div>

@code {
    IReadOnlyList<ProjectSummary> projects = [];
    string newName = "";
    string? error;

    protected override void OnInitialized() => projects = Store.List();

    static string ProjectUrl(string name) => "project/" + Uri.EscapeDataString(name);

    void Create()
    {
        try
        {
            var project = Store.Create(newName);
            Navigation.NavigateTo(ProjectUrl(project.Name));
        }
        catch (Exception e) when (e is ArgumentException or IOException or UnauthorizedAccessException)
        {
            error = e.Message;
        }
    }
}
