@using System.Globalization
@using System.Text
@using ThingCommodore.Graphics
@inject IJSRuntime JS

@* The memory of the C64 (a snapshot of the running machine) to look through: as bytes and characters, with the number
   of bytes in a row and the offset as you like, or decoded as a screen of characters, a charset, sprites or a bitmap,
   to find them in the dump. The offset moves a byte at a time (buttons, arrow keys, the wheel, the slider, a click on
   what you see), because what you look for does not start where a row starts *@
<div class="@(Visible ? "flex" : "hidden") absolute inset-0 z-10 flex-col overflow-hidden bg-night-900 text-xs text-night-200">
    <div class="flex shrink-0 flex-wrap items-center gap-2 border-b border-night-800 bg-night-950 px-3 py-2">
        <span class="text-sm font-semibold text-white">Memory</span>
        <span class="text-night-400">@(memory is null ? "no snapshot yet" : $"snapshot of {takenAt:HH:mm:ss}")</span>
        <button class="tool border border-night-700" @onclick="OnSnapshot" title="Take the memory of the running C64 again">📷 Snapshot</button>
        <span class="mx-1 h-5 border-l border-night-700"></span>
        @foreach (var (key, label) in Views)
        {
            string choice = key;
            <button class="@(view == choice ? "border-chip-400 bg-night-700 text-white" : "border-night-600") rounded border px-2 py-1" @onclick="() => SetView(choice)">@label</button>
        }
        <span class="mx-1 h-5 border-l border-night-700"></span>
        <form class="flex items-center gap-1" @onsubmit="GoTo">
            <label class="text-night-400" for="memory-address">address</label>
            <input id="memory-address" class="field w-24 py-0.5 font-mono" @bind="goTo" placeholder="$2000" />
            <button class="rounded border border-night-600 px-2 py-0.5">Go</button>
        </form>
        <span class="ml-auto text-night-300">@status</span>
        <button class="tool border border-night-700" @onclick="OnClose" title="Back to the C64">✕ Close</button>
    </div>

    @if (memory is null)
    {
        <div class="flex flex-1 flex-col items-center justify-center gap-3 text-night-300">
            <p>The memory viewer shows the 64 KB of the running C64. Run a program, then take a snapshot.</p>
            <button class="rounded-md border border-night-600 px-3 py-1.5 text-sm hover:border-chip-400" @onclick="OnSnapshot">📷 Snapshot</button>
        </div>
    }
    else
    {
        <div class="flex min-h-0 flex-1">
            <div class="flex min-w-0 flex-1 flex-col">
                <div class="flex shrink-0 flex-wrap items-center gap-1 border-b border-night-800 px-3 py-1.5">
                    <span class="mr-1 font-mono text-chip-300">$@offset.ToString("X4")</span>
                    <button class="tool border border-night-700" title="A page back" @onclick="() => Move(-Page)">⏮</button>
                    <button class="tool border border-night-700" title="A row back (@Row bytes)" @onclick="() => Move(-Row)">▲ row</button>
                    @if (Item > 1)
                    {
                        <button class="tool border border-night-700" title="One @ItemName back (@Item bytes)" @onclick="() => Move(-Item)">◀ @ItemName</button>
                    }
                    <button class="tool border border-night-700" title="One byte back" @onclick="() => Move(-1)">-1</button>
                    <button class="tool border border-night-700" title="One byte on" @onclick="() => Move(1)">+1</button>
                    @if (Item > 1)
                    {
                        <button class="tool border border-night-700" title="One @ItemName on (@Item bytes)" @onclick="() => Move(Item)">@ItemName ▶</button>
                    }
                    <button class="tool border border-night-700" title="A row on (@Row bytes)" @onclick="() => Move(Row)">▼ row</button>
                    <button class="tool border border-night-700" title="A page on" @onclick="() => Move(Page)">⏭</button>
                    <input type="range" min="0" max="@(Size - 1)" step="1" value="@offset" class="ml-2 min-w-40 flex-1" @oninput="Slide" title="Anywhere in the memory" />
                </div>

                <div class="min-h-0 flex-1 overflow-auto p-3 outline-none" tabindex="-1" @onkeydown="Key" @onkeydown:preventDefault @onwheel="Wheel" @onwheel:preventDefault>
                    @if (view == "hex")
                    {
                        <div class="font-mono text-[13px] leading-6">
                            @for (int r = 0; r < hexRows; r++)
                            {
                                int address = (offset + r * bytesPerRow) & (Size - 1);
                                <div class="flex cursor-pointer whitespace-pre rounded-sm hover:bg-night-800" @onclick="() => { offset = address; Refresh(); }">
                                    <span class="w-14 shrink-0 text-night-400">$@address.ToString("X4")</span>
                                    <span class="shrink-0">@HexOf(address)</span>
                                    <span class="ml-3 shrink-0 border-l border-night-800 pl-3">@foreach (var (text, reverse) in CharsOf(address)) { <span class="@(reverse ? "bg-night-200 text-night-900" : null)">@text</span> }</span>
                                </div>
                            }
                        </div>
                    }
                    else if (imageUrl is not null)
                    {
                        <div class="relative inline-block select-none" style="width: @(imageWidth * zoom)px; height: @(imageHeight * zoom)px; cursor: crosshair"
                             @onmousemove="Hover" @onmouseleave="Leave" @onclick="Pick">
                            <img src="@imageUrl" alt="" draggable="false" class="pixelated pointer-events-none absolute inset-0 h-full w-full" />
                            @if (grid)
                            {
                                <div class="pointer-events-none absolute inset-0"
                                     style="background-image: linear-gradient(to right, rgba(124,138,247,.3) 1px, transparent 1px), linear-gradient(to bottom, rgba(124,138,247,.3) 1px, transparent 1px); background-size: @(CellWidth * zoom)px @(CellHeight * zoom)px"></div>
                            }
                        </div>
                    }
                </div>
            </div>

            <aside class="w-64 shrink-0 space-y-3 overflow-y-auto border-l border-night-800 bg-night-950 p-3">
                <div>
                    <div class="mb-1 text-[11px] font-semibold tracking-wider text-night-300 uppercase">Memory</div>
                    <label class="flex items-center justify-between gap-2">from
                        <select class="field py-0.5" @bind="source" @bind:after="Refresh">
                            <option value="ram">RAM (64 KB)</option>
                            <option value="rom">character ROM (4 KB)</option>
                            <option value="color">Color RAM (1 KB)</option>
                        </select>
                    </label>
                    <p class="mt-1 text-night-400">RAM is all of it, also under the ROMs and the I/O. The VIC-II sees bank @memory.VicBank: screen $@memory.ScreenAddress.ToString("X4"), characters $@memory.CharsetAddress.ToString("X4")@(memory.CharsetIsRom ? " (ROM)" : "")@(memory.BitmapMode ? ", bitmap $" + memory.BitmapAddress.ToString("X4") : "").</p>
                    <button class="tool mt-1 border border-night-700" @onclick="UseVic" title="Offset, charset, screen and colors as the VIC-II has them now">↯ As the VIC-II shows it</button>
                </div>

                @if (view == "hex")
                {
                    <div class="space-y-1">
                        <div class="text-[11px] font-semibold tracking-wider text-night-300 uppercase">Bytes</div>
                        <label class="flex items-center justify-between gap-2">bytes in a row
                            <input type="number" min="1" max="64" class="field w-16 py-0.5" @bind="bytesPerRow" @bind:after="Refresh" />
                        </label>
                        <label class="flex items-center justify-between gap-2">rows
                            <input type="number" min="1" max="200" class="field w-16 py-0.5" @bind="hexRows" @bind:after="Refresh" />
                        </label>
                        <label class="flex items-center justify-between gap-2">characters
                            <select class="field py-0.5" @bind="characters" @bind:after="Refresh">
                                <option value="ascii">ASCII</option>
                                <option value="petscii">PETSCII</option>
                                <option value="screen">screen codes</option>
                            </select>
                        </label>
                        <button class="tool border border-night-700" @onclick="CopyBytes">⧉ Copy as .byte</button>
                    </div>
                }
                else
                {
                    <div class="space-y-1">
                        <div class="text-[11px] font-semibold tracking-wider text-night-300 uppercase">@Views.First(v => v.Key == view).Label</div>
                        @if (view == "screen")
                        {
                            <label class="flex items-center justify-between gap-2">columns
                                <input type="number" min="1" max="80" class="field w-16 py-0.5" @bind="columns" @bind:after="Refresh" />
                            </label>
                            <label class="flex items-center justify-between gap-2">rows
                                <input type="number" min="1" max="50" class="field w-16 py-0.5" @bind="screenRows" @bind:after="Refresh" />
                            </label>
                            <label class="flex items-center justify-between gap-2">characters
                                <select class="field py-0.5" @bind="screenCharset" @bind:after="Refresh">
                                    <option value="vic">as the VIC-II sees them</option>
                                    <option value="upper">ROM, upper case</option>
                                    <option value="lower">ROM, lower case</option>
                                    <option value="ram">RAM at...</option>
                                </select>
                            </label>
                            @if (screenCharset == "ram")
                            {
                                <label class="flex items-center justify-between gap-2">charset at
                                    <input class="field w-20 py-0.5 font-mono" value="@($"${charsetAddress:X4}")" @onchange="SetCharsetAddress" />
                                </label>
                            }
                            <label class="flex items-center justify-between gap-2">cells
                                <select class="field py-0.5" @bind="cellMode" @bind:after="Refresh">
                                    <option value="@CellMode.Hires">hires</option>
                                    <option value="@CellMode.MulticolorByColor">multicolor if the color is 8+</option>
                                    <option value="@CellMode.Multicolor">all multicolor</option>
                                </select>
                            </label>
                            <label class="flex items-center justify-between gap-2">colors
                                <select class="field py-0.5" @bind="screenColors" @bind:after="Refresh">
                                    <option value="colorram">Color RAM</option>
                                    <option value="fixed">one color</option>
                                </select>
                            </label>
                            @if (screenColors == "fixed") { @ColorChoice("color", ink, v => ink = v) }
                        }
                        @if (view == "charset")
                        {
                            <label class="flex items-center justify-between gap-2">characters
                                <input type="number" min="1" max="1024" class="field w-16 py-0.5" @bind="count" @bind:after="Refresh" />
                            </label>
                            <label class="flex items-center justify-between gap-2">in a row
                                <input type="number" min="1" max="64" class="field w-16 py-0.5" @bind="perRow" @bind:after="Refresh" />
                            </label>
                            <label class="flex items-center gap-2"><input type="checkbox" @bind="multicolor" @bind:after="Refresh" /> multicolor</label>
                            @ColorChoice("ink", ink, v => ink = v)
                            <button class="tool border border-night-700" @onclick="CopyCharset">⧉ Copy as charset</button>
                        }
                        @if (view == "sprites")
                        {
                            <label class="flex items-center justify-between gap-2">sprites
                                <input type="number" min="1" max="256" class="field w-16 py-0.5" @bind="count" @bind:after="Refresh" />
                            </label>
                            <label class="flex items-center justify-between gap-2">in a row
                                <input type="number" min="1" max="32" class="field w-16 py-0.5" @bind="perRow" @bind:after="Refresh" />
                            </label>
                            <label class="flex items-center justify-between gap-2" title="64: the usual blocks; 63: one after the other">bytes each
                                <input type="number" min="63" max="256" class="field w-16 py-0.5" @bind="stride" @bind:after="Refresh" />
                            </label>
                            <label class="flex items-center gap-2"><input type="checkbox" @bind="multicolor" @bind:after="Refresh" /> multicolor</label>
                            @ColorChoice("sprite color", ink, v => ink = v)
                        }
                        @if (view == "bitmap")
                        {
                            <label class="flex items-center gap-2"><input type="checkbox" @bind="multicolor" @bind:after="Refresh" /> multicolor</label>
                            <label class="flex items-center justify-between gap-2" title="Its colors: the screen RAM (hires: ink and background; multicolor: two of the colors)">screen RAM at
                                <input class="field w-20 py-0.5 font-mono" value="@($"${bitmapScreen:X4}")" @onchange="SetBitmapScreen" />
                            </label>
                        }
                        @ColorChoice(view == "sprites" ? "transparent" : "background", background, v => background = v)
                        @ColorChoice("multicolor 1", multicolor1, v => multicolor1 = v)
                        @ColorChoice("multicolor 2", multicolor2, v => multicolor2 = v)
                        <label class="flex items-center justify-between gap-2">zoom
                            <select class="field py-0.5" @bind="zoom">
                                @for (int z = 1; z <= 6; z++) { <option value="@z">@(z)x</option> }
                            </select>
                        </label>
                        <label class="flex items-center gap-2"><input type="checkbox" @bind="grid" /> grid</label>
                        <button class="tool border border-night-700" @onclick="ColorsFromVic" title="The background and the multicolors the VIC-II has now">↯ Colors of the VIC-II</button>
                        <p class="text-night-400">Click on what you see to start there; the wheel, the arrow keys and Page Up and Down move the offset.</p>
                    </div>
                }
            </aside>
        </div>
    }
</div>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnSnapshot { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    static readonly (string Key, string Label)[] Views =
    [
        ("hex", "Bytes"), ("screen", "Screen"), ("charset", "Charset"), ("sprites", "Sprites"), ("bitmap", "Bitmap"),
    ];

    MemoryCapture? memory;
    DateTime takenAt;

    public bool HasMemory => memory is not null;
    byte[] ram = [], rom = [], colorRam = [];
    byte[] ramBuffer = [], romBuffer = [], colorBuffer = [];   // each padded to 64 KB, what the pictures read

    string view = "hex";
    string source = "ram";
    int offset;
    string goTo = "";
    string status = "";

    // Bytes
    int bytesPerRow = 16, hexRows = 32;
    string characters = "petscii";

    // Pictures
    int zoom = 3;
    bool grid = true;
    string? imageUrl;
    int imageWidth, imageHeight;
    int columns = 40, screenRows = 25;
    string screenCharset = "vic", screenColors = "colorram";
    CellMode cellMode = CellMode.MulticolorByColor;
    int charsetAddress = 0x2800, bitmapScreen = 0x0400;
    int count = 256, perRow = 16, stride = 64;
    bool multicolor;
    int background = 6, multicolor1 = 14, multicolor2 = 1, ink = 7;

    int Size => source switch { "rom" => MemoryCapture.CharsetRomSize, "color" => MemoryCapture.ColorSize, _ => MemoryCapture.RamSize };
    byte[] Buffer => source switch { "rom" => romBuffer, "color" => colorBuffer, _ => ramBuffer };

    // The bytes a step moves: a row, an item (a character, a sprite, a cell of a bitmap), a page
    int Row => view switch
    {
        "screen" => columns,
        "charset" => perRow * 8,
        "sprites" => perRow * stride,
        "bitmap" => 320,
        _ => bytesPerRow,
    };
    int Item => view switch { "charset" => 8, "sprites" => stride, "bitmap" => 8, _ => 1 };
    string ItemName => view switch { "charset" => "character", "sprites" => "sprite", _ => "cell" };
    int Page => view switch
    {
        "hex" => bytesPerRow * hexRows,
        "screen" => columns * screenRows,
        "charset" => count * 8,
        "sprites" => count * stride,
        "bitmap" => 8000,
        _ => 256,
    };
    int CellWidth => view switch { "charset" => 8, "sprites" => 24, _ => 8 };
    int CellHeight => view switch { "sprites" => 21, _ => 8 };

    // A new snapshot from the studio: what the C64 had when the button was pressed
    public void SetMemory(byte[] bytes)
    {
        bool first = memory is null;
        memory = new MemoryCapture(bytes);
        takenAt = DateTime.Now;
        ram = memory.Ram;
        rom = memory.CharsetRom;
        colorRam = memory.ColorRam;
        ramBuffer = ram;
        romBuffer = Pad(rom);
        colorBuffer = Pad(colorRam);
        status = "";
        if (first) UseVic();                                    // the first time: where the VIC-II has its screen, and its colors
        Refresh();
        StateHasChanged();
    }

    static byte[] Pad(byte[] bytes)
    {
        var padded = new byte[MemoryCapture.RamSize];
        bytes.CopyTo(padded, 0);
        return padded;
    }

    // The offset, the charset, the screen and the colors the VIC-II has now
    void UseVic()
    {
        if (memory is null) return;
        source = "ram";
        multicolor = memory.MulticolorMode;
        cellMode = memory.MulticolorMode ? CellMode.MulticolorByColor : CellMode.Hires;
        screenCharset = "vic";
        charsetAddress = memory.CharsetAddress;
        bitmapScreen = memory.ScreenAddress;
        if (view == "bitmap") offset = memory.BitmapAddress;
        else if (view == "charset") offset = memory.CharsetAddress;
        else if (view != "sprites") offset = memory.ScreenAddress;
        ColorsFromVic();
        Refresh();
    }

    void ColorsFromVic()
    {
        if (memory is null) return;
        if (view == "sprites")
        {
            background = memory.Background;
            multicolor1 = memory.SpriteMulticolor1;
            multicolor2 = memory.SpriteMulticolor2;
            ink = memory.SpriteColor(0);
        }
        else
        {
            background = memory.Background;
            multicolor1 = memory.Multicolor1;
            multicolor2 = memory.Multicolor2;
        }
        Refresh();
    }

    void SetView(string next)
    {
        view = next;
        zoom = next switch { "screen" => 3, "charset" => 3, "sprites" => 2, "bitmap" => 2, _ => zoom };
        count = next switch { "charset" => 256, "sprites" => 24, _ => count };
        perRow = next switch { "charset" => 16, "sprites" => 8, _ => perRow };
        if (memory is not null && next == "sprites") offset = offset & ~63;
        if (memory is not null) ColorsFromVic();
        Refresh();
    }

    // The offset, always inside the memory the view is on
    void Move(int delta)
    {
        offset = (offset + delta) & (Size - 1);
        Refresh();
    }

    void Slide(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int value)) offset = Math.Clamp(value, 0, Size - 1);
        Refresh();
    }

    void Wheel(WheelEventArgs e) => Move(e.DeltaY > 0 ? Row : -Row);

    void Key(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowUp": Move(-Row); break;
            case "ArrowDown": Move(Row); break;
            case "ArrowLeft": Move(e.ShiftKey ? -Item : -1); break;
            case "ArrowRight": Move(e.ShiftKey ? Item : 1); break;
            case "PageUp": Move(-Page); break;
            case "PageDown": Move(Page); break;
            case "Home": offset = 0; Refresh(); break;
            case "End": offset = Size - 1; Refresh(); break;
        }
    }

    // $hex, a decimal number or +n/-n from here
    void GoTo()
    {
        string text = goTo.Trim().Replace("_", "");
        int value;
        bool ok;
        if (text.StartsWith('+') || text.StartsWith('-')) { ok = int.TryParse(text, out int delta); value = offset + delta; }
        else if (text.StartsWith('$')) ok = int.TryParse(text[1..], NumberStyles.HexNumber, null, out value);
        else if (text.StartsWith("0x", StringComparison.OrdinalIgnoreCase)) ok = int.TryParse(text[2..], NumberStyles.HexNumber, null, out value);
        else ok = int.TryParse(text, out value);
        if (!ok || value < 0 || value >= Size) { status = $"{text} is not an address from 0 to ${Size - 1:X4}"; return; }
        offset = value;
        Refresh();
    }

    bool ParseAddress(object? text, out int address)
    {
        string value = text?.ToString()?.Trim() ?? "";
        bool ok = value.StartsWith('$') ? int.TryParse(value[1..], NumberStyles.HexNumber, null, out address) : int.TryParse(value, out address);
        ok = ok && address is >= 0 and < 65536;
        if (!ok) status = $"{value} is not an address";
        return ok;
    }

    void SetCharsetAddress(ChangeEventArgs e) { if (ParseAddress(e.Value, out int a)) { charsetAddress = a; Refresh(); } }
    void SetBitmapScreen(ChangeEventArgs e) { if (ParseAddress(e.Value, out int a)) { bitmapScreen = a; Refresh(); } }

    // ------------------------------------------------------------------------------------------------- bytes

    string HexOf(int address)
    {
        var text = new StringBuilder();
        for (int i = 0; i < bytesPerRow; i++)
        {
            if (i > 0) text.Append(i % 8 == 0 ? "  " : " ");
            text.Append(Buffer[(address + i) & (Size - 1)].ToString("X2"));
        }
        return text.ToString();
    }

    IEnumerable<(string Text, bool Reverse)> CharsOf(int address)
    {
        for (int i = 0; i < bytesPerRow; i++) yield return CharOf(Buffer[(address + i) & (Size - 1)]);
    }

    (string Text, bool Reverse) CharOf(byte value) => characters switch
    {
        "ascii" => (value is >= 0x20 and < 0x7F ? ((char)value).ToString() : "·", false),
        "screen" => (ScreenCode(value & 0x7F), value >= 0x80),
        _ => (Petscii(value), false),
    };

    static string ScreenCode(int code) => code switch
    {
        0 => "@",
        >= 1 and <= 26 => ((char)('A' + code - 1)).ToString(),
        27 => "[", 28 => "£", 29 => "]", 30 => "↑", 31 => "←",
        >= 0x20 and <= 0x3F => ((char)code).ToString(),
        _ => "▒",
    };

    static string Petscii(byte value) => value switch
    {
        >= 0x20 and <= 0x5A => ((char)value).ToString(),
        0x5B => "[", 0x5C => "£", 0x5D => "]", 0x5E => "↑", 0x5F => "←",
        >= 0xC1 and <= 0xDA => ((char)(value - 0x80)).ToString(),
        >= 0x60 and <= 0x7F or >= 0xA0 and <= 0xBF => "▒",
        _ => "·",
    };

    async Task CopyBytes()
    {
        var text = new StringBuilder();
        for (int r = 0; r < hexRows; r++)
        {
            int address = (offset + r * bytesPerRow) & (Size - 1);
            text.AppendLine("            .byte " + string.Join(",", Enumerable.Range(0, bytesPerRow).Select(i => $"${Buffer[(address + i) & (Size - 1)]:X2}")) + $" ; ${address:X4}");
        }
        await JS.InvokeVoidAsync("thing64Studio.copyText", text.ToString());
        status = $"{hexRows * bytesPerRow} bytes copied";
    }

    // The characters as a ;@ charset region, ready for a file of the project
    async Task CopyCharset()
    {
        var text = new StringBuilder();
        text.AppendLine(";@ charset first=$00" + (multicolor ? " multicolor=1" : ""));
        text.AppendLine("charset__characters:");
        for (int k = 0; k < count; k++)
            text.AppendLine("            .byte " + string.Join(",", Enumerable.Range(0, 8).Select(i => $"${Buffer[(offset + k * 8 + i) & (Size - 1)]:X2}")) + $" ; ${k:X2} (from ${(offset + k * 8) & (Size - 1):X4})");
        text.AppendLine("charset__charactersEnd:");
        text.AppendLine(";@ end");
        await JS.InvokeVoidAsync("thing64Studio.copyText", text.ToString());
        status = $"{count} characters copied";
    }

    // ----------------------------------------------------------------------------------------------- pictures

    PaintColors Colors => new(background, multicolor1, multicolor2, ink);

    // The picture of the view, made when something changes (not at each move of the mouse)
    void Refresh()
    {
        if (memory is null) return;
        offset &= Size - 1;
        if (view == "hex") { imageUrl = null; return; }
        try
        {
            RgbImage image = view switch
            {
                "screen" => MemoryRender.Screen(Buffer, colorRam, offset, columns, screenRows, CharRows(), cellMode, Colors,
                                                screenColors == "fixed" ? ink : null),
                "charset" => MemoryRender.Charset(Buffer, offset, count, perRow, multicolor, Colors),
                "sprites" => MemoryRender.Sprites(Buffer, offset, count, perRow, multicolor, Colors, stride),
                _ => MemoryRender.Bitmap(Buffer, colorRam, offset, bitmapScreen, multicolor, background),
            };
            imageWidth = image.Width;
            imageHeight = image.Height;
            imageUrl = "data:image/png;base64," + Convert.ToBase64String(Png.Write(image));
        }
        catch (Exception e) when (e is ArgumentException or IndexOutOfRangeException)
        {
            status = e.Message;
            imageUrl = null;
        }
    }

    // How a screen finds the bytes of a character: as the VIC-II does, from the character ROM, or from RAM
    Func<int, int, byte> CharRows() => screenCharset switch
    {
        "upper" => (code, row) => rom[(code * 8 + row) & 0x0FFF],
        "lower" => (code, row) => rom[(0x0800 + code * 8 + row) & 0x0FFF],
        "ram" => (code, row) => ram[(charsetAddress + code * 8 + row) & 0xFFFF],
        _ => (code, row) => memory!.CharacterRow(code, row),
    };

    // What is under the mouse, as an address and an index
    (int Address, string Text)? At(MouseEventArgs e)
    {
        int x = (int)(e.OffsetX / zoom), y = (int)(e.OffsetY / zoom);
        if (x < 0 || y < 0 || x >= imageWidth || y >= imageHeight) return null;
        switch (view)
        {
            case "screen":
            {
                int cell = y / 8 * columns + x / 8;
                int address = (offset + cell) & (Size - 1);
                return (address, $"cell {x / 8},{y / 8} at ${address:X4}: screen code ${Buffer[address]:X2}");
            }
            case "charset":
            {
                int k = y / 8 * perRow + x / 8;
                int address = (offset + k * 8) & (Size - 1);
                return (address, $"character #{k} (${k:X2}) at ${address:X4}");
            }
            case "sprites":
            {
                int k = y / 21 * perRow + x / 24;
                int address = (offset + k * stride) & (Size - 1);
                return (address, $"sprite #{k} at ${address:X4} (block {address / 64:X2}, ${address / 64:X2} * 64)");
            }
            default:
            {
                int cell = y / 8 * 40 + x / 8;
                int address = (offset + cell * 8) & (Size - 1);
                return (address, $"cell {x / 8},{y / 8}: bitmap byte at ${address:X4}");
            }
        }
    }

    void Hover(MouseEventArgs e) => status = At(e)?.Text ?? "";

    void Leave() => status = "";

    void Pick(MouseEventArgs e)
    {
        if (At(e) is { } at)
        {
            offset = at.Address;
            Refresh();
        }
    }

    // A color to choose, 0-15 by name
    RenderFragment ColorChoice(string label, int value, Action<int> set) =>
        @<label class="flex items-center justify-between gap-2">@label
            <span class="flex items-center gap-1">
                <span class="h-4 w-4 rounded-sm border border-night-700" style="background: #@C64Palette.Pepto.Rgb[value].ToString("X6")"></span>
                <select class="field py-0.5" value="@value" @onchange="e => { set(int.Parse(e.Value!.ToString()!)); Refresh(); }">
                    @for (int c = 0; c < 16; c++) { <option value="@c">@c @C64Palette.Names[c]</option> }
                </select>
            </span>
        </label>;
}
